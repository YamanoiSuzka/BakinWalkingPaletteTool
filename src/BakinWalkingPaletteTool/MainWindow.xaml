<Window x:Class="BakinWalkingPaletteTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BakinWalkingPaletteTool.Models"
        Title="PNG ドット絵パレット変換ツール"
        Width="1080"
        Height="720"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Z"
                    Modifiers="Control"
                    Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y"
                    Modifiers="Control"
                    Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Grid Background="#FFF5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,18"
                Background="#FF263245">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="ピクセルカラーチェンジャー" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#FFD5DCE8"
                           Text="PNGファイルの色変更と、命名規則に合うスプライトシートの一括色変換に対応します。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20"
                    Background="White"
                    BorderBrush="#FFD9DEE7"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="画像グループ一覧" />

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding SelectFolderCommand}"
                                Content="フォルダ選択" />
                        <Button Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SelectFileCommand}"
                                Content="PNG選択" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,10"
                               Foreground="#FF667085"
                               Text="{Binding CurrentFolder}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentFolder}" />

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  BorderBrush="#FFD9DEE7"
                                  BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding CharacterGroups}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CharacterGroup}">
                                <Expander IsExpanded="{Binding IsExpanded}"
                                          BorderBrush="#FFE4E7EC"
                                          BorderThickness="0,0,0,1">
                                    <Expander.Header>
                                        <Grid Margin="4,7"
                                              Width="255">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Margin="8,0,16,0"
                                                    Padding="7,2"
                                                    Background="#FFE8EEF8"
                                                    CornerRadius="9">
                                                <TextBlock FontSize="11"
                                                           Foreground="#FF344054"
                                                           Text="{Binding FileCount}" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl Margin="16,0,8,8"
                                                  ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SpriteFile}">
                                                <Button Margin="0,2"
                                                        Padding="10,7"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectSpriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ButtonBorder"
                                                                                Padding="{TemplateBinding Padding}"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ButtonBorder"
                                                                                        Property="Background"
                                                                                        Value="#FFF2F4F7" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#FFDCE9FF" />
                                                                    <Setter Property="BorderBrush" Value="#FF75A7F7" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FilePath}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="#FF667085"
                                                                   Text="{Binding AnimationName}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="White"
                    BorderBrush="#FFD9DEE7"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedSpriteFile.FileName, TargetNullValue=画像を選択してください}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                MinWidth="82"
                                Command="{Binding UndoCommand}"
                                Content="↶ UNDO" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                MinWidth="82"
                                Command="{Binding RedoCommand}"
                                Content="↷ REDO" />
                        <Button Grid.Column="3"
                                Margin="12,0,0,0"
                                Command="{Binding SaveCharacterCommand}"
                                Content="別名保存する" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,20"
                            BorderBrush="#FFE4E7EC"
                            BorderThickness="1"
                            ClipToBounds="True"
                            PreviewMouseWheel="PreviewImage_PreviewMouseWheel"
                            CornerRadius="4">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile"
                                          Viewport="0,0,20,20"
                                          ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFF7F8FA">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,20,20" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFE3E6EA">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,10,10" />
                                                    <RectangleGeometry Rect="10,10,10,10" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="PreviewImageControl"
                                   Margin="16"
                                   Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"
                                   MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                                   MouseRightButtonDown="PreviewImage_MouseRightButtonDown"
                                   ToolTip="左クリック: 色を置換 / 右クリック: 選択・選択解除 / マウスホイール: 拡大・縮小">
                                <Image.RenderTransform>
                                    <MatrixTransform x:Name="PreviewMatrixTransform" />
                                </Image.RenderTransform>
                            </Image>

                            <Border Margin="0,0,8,8"
                                    Padding="7,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#CC263245"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="PreviewZoomTextBlock"
                                           FontSize="11"
                                           Foreground="White"
                                           Text="100%" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="カラーパレット（右クリックで複数選択）" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF667085"
                                   Text="{Binding SelectedColorCount, StringFormat=選択 {0}色}" />
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF667085"
                                   Text="{Binding PaletteColors.Count, StringFormat={}{0}色}" />
                        <CheckBox Grid.Column="3"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="全選択 / 全解除"
                                  IsChecked="{Binding AreAllPaletteColorsSelected, Mode=TwoWay}" />
                    </Grid>

                    <ScrollViewer Grid.Row="3"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PaletteColor}">
                                    <Button Width="150"
                                            Margin="0,0,8,8"
                                            Padding="7"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectPaletteColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            PreviewMouseRightButtonDown="PaletteButton_PreviewMouseRightButtonDown"
                                            ToolTip="左クリック: 色を置換 / 右クリック: 複数選択 / コード: #RRGGBBAA">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="MinHeight" Value="42" />
                                                <Setter Property="Background" Value="#FFF8FAFC" />
                                                <Setter Property="BorderBrush" Value="#FFE4E7EC" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#FFDCE9FF" />
                                                        <Setter Property="BorderBrush" Value="#FF2672D9" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28"
                                                    Height="28"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="#FF98A2B3"
                                                    BorderThickness="1"
                                                    CornerRadius="3" />
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,0,0">
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="12"
                                                           Text="{Binding HexCode}" />
                                                <TextBlock FontSize="10"
                                                           Foreground="#FF667085"
                                                           Text="{Binding PixelCount, StringFormat={}{0:N0} px}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="4"
                            Margin="0,12,0,0"
                            MinWidth="130"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding HasSelectedColors}"
                            Click="OpenColorAdjustmentDialog_Click"
                            Content="色の調整..." />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="White"
                BorderBrush="#FFD9DEE7"
                BorderThickness="0,1,0,0">
            <TextBlock Foreground="#FF667085"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
