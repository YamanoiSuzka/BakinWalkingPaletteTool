<Window x:Class="BakinWalkingPaletteTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bakin 歩行グラフィック一括パレット変換ツール"
        Width="1080"
        Height="720"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,18"
                Background="#FF263245">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Bakin 歩行グラフィック一括パレット変換ツール" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#FFD5DCE8"
                           Text="同じキャラクターのPNG素材へ、共通の色置換をまとめて適用します。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20"
                    Background="White"
                    BorderBrush="#FFD9DEE7"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="対象ファイル" />
                    <TextBlock Margin="0,8,0,16"
                               Foreground="#FF667085"
                               TextWrapping="Wrap"
                               Text="キャラクター名_アニメーション名.png の形式で、同じフォルダーにある素材を読み込みます。" />
                    <Button HorizontalAlignment="Left"
                            IsEnabled="False"
                            Content="フォルダーを選択（次の実装段階）" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="White"
                    BorderBrush="#FFD9DEE7"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="パレット置換" />
                    <TextBlock Margin="0,8,0,16"
                               Foreground="#FF667085"
                               TextWrapping="Wrap"
                               Text="元の色と変換後の色を登録し、プレビューを確認して一括出力します。" />
                    <Border Padding="20"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFE4E7EC"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#FF98A2B3"
                                   Text="パレット編集画面は次の実装段階で追加します" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="White"
                BorderBrush="#FFD9DEE7"
                BorderThickness="0,1,0,0">
            <TextBlock Foreground="#FF667085"
                       Text="プロジェクト初期構成 — 準備完了" />
        </Border>
    </Grid>
</Window>

