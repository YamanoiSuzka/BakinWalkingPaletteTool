<Window x:Class="PixelRecolor.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色を選択"
        Width="560"
        MinWidth="500"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <LinearGradientBrush x:Key="SaturationGradient"
                             StartPoint="0,0.5"
                             EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ValueGradient"
                             StartPoint="0.5,0"
                             EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="置き換え後の色" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,16"
                   Foreground="#FF667085"
                   Text="変更はメイン画面のプレビューへリアルタイムで表示されます。" />

        <!-- 彩度（横方向）と明度（縦方向）を指定する2次元エリアです。 -->
        <Grid x:Name="SaturationValuePicker"
              Grid.Row="2"
              Height="250"
              Margin="8,0"
              Background="Transparent"
              Cursor="Cross"
              MouseLeftButtonDown="SaturationValuePicker_MouseLeftButtonDown"
              MouseMove="SaturationValuePicker_MouseMove"
              MouseLeftButtonUp="Picker_MouseLeftButtonUp"
              LostMouseCapture="Picker_LostMouseCapture">
            <Border x:Name="HueColorBorder"
                    BorderBrush="#FF98A2B3"
                    BorderThickness="1"
                    CornerRadius="7">
                <Border Background="{StaticResource SaturationGradient}">
                    <Border Background="{StaticResource ValueGradient}" />
                </Border>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SaturationValueThumb"
                         Width="18"
                         Height="18"
                         Fill="Transparent"
                         Stroke="White"
                         StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="2"
                                          Opacity="0.8"
                                          ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- 色相を0～360度で指定します。 -->
        <Grid x:Name="HuePicker"
              Grid.Row="3"
              Height="24"
              Margin="8,18,8,0"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="HuePicker_MouseLeftButtonDown"
              MouseMove="HuePicker_MouseMove"
              MouseLeftButtonUp="Picker_MouseLeftButtonUp"
              LostMouseCapture="Picker_LostMouseCapture">
            <Border BorderBrush="#FF98A2B3"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#FFFF0000" />
                        <GradientStop Offset="0.1667" Color="#FFFFFF00" />
                        <GradientStop Offset="0.3333" Color="#FF00FF00" />
                        <GradientStop Offset="0.5" Color="#FF00FFFF" />
                        <GradientStop Offset="0.6667" Color="#FF0000FF" />
                        <GradientStop Offset="0.8333" Color="#FFFF00FF" />
                        <GradientStop Offset="1" Color="#FFFF0000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb"
                         Width="16"
                         Height="30"
                         Fill="White"
                         Stroke="#FF667085"
                         StrokeThickness="2" />
            </Canvas>
        </Grid>

        <!-- 透明から不透明までのアルファ値を指定します。 -->
        <Grid x:Name="AlphaPicker"
              Grid.Row="4"
              Height="24"
              Margin="8,14,8,0"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="AlphaPicker_MouseLeftButtonDown"
              MouseMove="AlphaPicker_MouseMove"
              MouseLeftButtonUp="Picker_MouseLeftButtonUp"
              LostMouseCapture="Picker_LostMouseCapture">
            <Border BorderBrush="#FF98A2B3"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Background>
                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,12,12"
                                  ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,12,12" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FFD9DDE3">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,6,6" />
                                            <RectangleGeometry Rect="6,6,6,6" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Border x:Name="AlphaGradientBorder"
                        CornerRadius="12" />
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="AlphaThumb"
                         Width="16"
                         Height="30"
                         Fill="White"
                         Stroke="#FF667085"
                         StrokeThickness="2" />
            </Canvas>
        </Grid>

        <StackPanel Grid.Row="5"
                    Margin="8,18,8,0"
                    Orientation="Horizontal">
            <RadioButton x:Name="HexModeRadioButton"
                         VerticalAlignment="Center"
                         Content="HEX指定"
                         GroupName="ColorInputMode"
                         Checked="InputModeRadioButton_Checked" />
            <RadioButton x:Name="RgbaModeRadioButton"
                         Margin="22,0,0,0"
                         VerticalAlignment="Center"
                         Content="RGBA指定"
                         GroupName="ColorInputMode"
                         Checked="InputModeRadioButton_Checked" />
        </StackPanel>

        <Grid Grid.Row="6"
              Margin="8,12,8,0">
            <Grid x:Name="HexInputPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="HEX" />
                <TextBox x:Name="HexTextBox"
                         Grid.Column="1"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         TextChanged="HexTextBox_TextChanged"
                         LostKeyboardFocus="HexTextBox_LostKeyboardFocus"
                         ToolTip="#RRGGBB または #RRGGBBAA" />
            </Grid>

            <Grid x:Name="RgbaInputPanel"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="R" />
                <TextBox x:Name="RedTextBox"
                         Grid.Column="1"
                         Margin="0,0,12,0"
                         Padding="6,5"
                         TextChanged="RgbaTextBox_TextChanged" />
                <TextBlock Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="G" />
                <TextBox x:Name="GreenTextBox"
                         Grid.Column="3"
                         Margin="0,0,12,0"
                         Padding="6,5"
                         TextChanged="RgbaTextBox_TextChanged" />
                <TextBlock Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center" Text="B" />
                <TextBox x:Name="BlueTextBox"
                         Grid.Column="5"
                         Margin="0,0,12,0"
                         Padding="6,5"
                         TextChanged="RgbaTextBox_TextChanged" />
                <TextBlock Grid.Column="6" Margin="0,0,6,0" VerticalAlignment="Center" Text="A" />
                <TextBox x:Name="AlphaTextBox"
                         Grid.Column="7"
                         Padding="6,5"
                         TextChanged="RgbaTextBox_TextChanged" />
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationMessageTextBlock"
                   Grid.Row="7"
                   Margin="8,8,190,0"
                   Foreground="#FFB42318"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="7"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="90"
                    IsCancel="True"
                    Content="キャンセル" />
            <Button x:Name="OkButton"
                    Margin="8,0,0,0"
                    MinWidth="90"
                    IsDefault="True"
                    Click="OkButton_Click"
                    Content="OK" />
        </StackPanel>
    </Grid>
</Window>
